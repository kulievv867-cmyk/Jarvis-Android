<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/jBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/jTextPrimary"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_theme"
            android:textColor="?attr/jTextPrimary"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <Spinner
            android:id="@+id/themeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_change_note"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_lang"
            android:textColor="?attr/jTextPrimary"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <Spinner
            android:id="@+id/langSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_key"
            android:textColor="?attr/jTextPrimary"
            android:textSize="14sp"
            android:paddingBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_key_desc"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/keyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/jAccent"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/keyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textVisiblePassword"
            android:hint="@string/key_hint_empty"
            android:textColor="?attr/jTextPrimary"
            android:textColorHint="?attr/jTextSecondary"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveKeyBtn"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/key_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearKeyBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/key_clear" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/llmSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_use_llm"
            android:textColor="?attr/jTextPrimary"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/modulationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_modulation"
            android:textColor="?attr/jTextPrimary"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/reverbSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_reverb"
            android:textColor="?attr/jTextPrimary"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/whisperSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_use_whisper"
            android:textColor="?attr/jTextPrimary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_use_whisper_desc"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_whisper_model_label"
            android:textColor="?attr/jTextPrimary"
            android:textSize="13sp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <Spinner
            android:id="@+id/whisperModelSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_whisper_model_desc"
            android:textColor="?attr/jTextSecondary"
            android:textSize="11sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/whisperStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="?attr/jAccent"
            android:textSize="12sp"
            android:visibility="gone"
            android:paddingBottom="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/whisperDeleteBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_use_whisper_delete"
            android:visibility="gone"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_personalisation"
            android:textColor="?attr/jTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:paddingBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_personalisation_desc"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/userNameEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_user_name"
            android:inputType="textPersonName"
            android:textColor="?attr/jTextPrimary"
            android:textColorHint="?attr/jTextSecondary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/userCityEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_user_city"
            android:inputType="textPostalAddress"
            android:textColor="?attr/jTextPrimary"
            android:textColorHint="?attr/jTextSecondary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/userCountryEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_user_country"
            android:inputType="textPostalAddress"
            android:textColor="?attr/jTextPrimary"
            android:textColorHint="?attr/jTextSecondary"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/userTimezoneEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_user_timezone"
            android:inputType="text"
            android:textColor="?attr/jTextPrimary"
            android:textColorHint="?attr/jTextSecondary"
            android:layout_marginBottom="20dp" />

        <!-- v3 advanced features -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="?attr/jTextSecondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_v3_section"
            android:textColor="?attr/jTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:paddingBottom="2dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/longMemorySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_long_memory"
            android:textColor="?attr/jTextPrimary"
            android:layout_marginTop="6dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_long_memory_desc"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fastTtsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_fast_tts"
            android:textColor="?attr/jTextPrimary"
            android:layout_marginTop="6dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_fast_tts_desc"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/internalAlarmSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_internal_alarm"
            android:textColor="?attr/jTextPrimary"
            android:layout_marginTop="6dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_internal_alarm_desc"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:paddingBottom="14dp" />

        <!-- Proxy / VPN section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_proxy_section"
            android:textColor="?attr/jTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:paddingBottom="2dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_proxy_desc"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/useProxySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_use_proxy"
            android:textColor="?attr/jTextPrimary"
            android:layout_marginTop="6dp" />

        <EditText
            android:id="@+id/proxyUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setting_proxy_url_hint"
            android:inputType="textUri"
            android:textColor="?attr/jTextPrimary"
            android:textColorHint="?attr/jTextSecondary"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/proxyCandidateSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/proxyTestBtn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/setting_proxy_test" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/proxyDiscoverBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/setting_proxy_discover" />
        </LinearLayout>

        <TextView
            android:id="@+id/proxyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/jTextSecondary"
            android:textSize="12sp"
            android:visibility="gone"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_proxy_warning"
            android:textColor="?attr/jTextSecondary"
            android:textSize="11sp"
            android:paddingBottom="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearMemoryBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_memory" />

    </LinearLayout>

</ScrollView>
